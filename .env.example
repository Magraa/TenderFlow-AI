# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Data Backend (local | firestore)
NEXT_PUBLIC_DATA_BACKEND=firestore

# Optional Firestore knobs
NEXT_PUBLIC_FIRESTORE_NAMESPACE=default
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=

# AI Configuration (optional - for enhanced document generation)
# Available providers: gemini, openai, groq, nvidia, mock
NEXT_PUBLIC_AI_PROVIDER=mock
NEXT_PUBLIC_AI_API_KEY=your_api_key_here
NEXT_PUBLIC_AI_MODEL=mock-1.0

# Provider-specific models:
# Gemini: gemini-1.5-flash, gemini-1.5-pro
# OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Groq: llama3-70b-8192, llama3-8b-8192, mixtral-8x7b-32768
# NVIDIA: meta/llama3-70b, mistralai/mistral-7b