// Firestore Security Rules
// Version: 1.0.0
// Description: Production-ready security rules for Tender Automation

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(documentId) {
      return isAuthenticated() && 
             resource.data.ownerId == request.auth.uid;
    }
    
    // Helper function to validate tender data
    function isValidTender() {
      return request.resource.data.keys().hasAll(['title', 'tenderNumber', 'mainFirmId', 'items']) &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 200 &&
             request.resource.data.tenderNumber.size() > 0 &&
             request.resource.data.tenderNumber.size() <= 50;
    }
    
    // Helper function to validate firm data
    function isValidFirm() {
      return request.resource.data.keys().hasAll(['name', 'headerImagePath']) &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100;
    }
    
    // Helper function to validate document data
    function isValidDocument() {
      return request.resource.data.keys().hasAll(['tenderId', 'docType', 'contentHTML']) &&
             request.resource.data.docType in ['vigyapti', 'quotation_main', 'quotation_alt_1', 'quotation_alt_2', 'supply_aadesh', 'firm_bill'];
    }
    
    // Helper function to validate department profile
    function isValidDepartmentProfile() {
      return request.resource.data.keys().hasAll(['name', 'address', 'city', 'state', 'pincode']) &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100;
    }
    
    // Helper function to validate settings
    function isValidSettings() {
      return request.resource.data.keys().hasAll(['organizationName', 'defaultLanguage']);
    }
    
    // ==========================================
    // Tenders Collection
    // ==========================================
    match /tap/{namespace}/tenders/{tenderId} {
      // Allow authenticated users to read tenders
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create tenders
      allow create: if isValidTender() && isAuthenticated();
      
      // Allow authenticated users to update their own tenders
      // Or allow updates if tender is in draft status (for collaboration)
      allow update: if isAuthenticated() && 
                           (isOwner(tenderId) || resource.data.status == 'draft');
      
      // Allow authenticated users to delete their own tenders
      allow delete: if isAuthenticated() && isOwner(tenderId);
    }
    
    // ==========================================
    // Firms Collection
    // ==========================================
    match /tap/{namespace}/firms/{firmId} {
      // Allow authenticated users to read firms
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create firms
      allow create: if isValidFirm() && isAuthenticated();
      
      // Allow authenticated users to update their own firms
      allow update: if isAuthenticated() && isOwner(firmId);
      
      // Allow authenticated users to delete their own firms
      allow delete: if isAuthenticated() && isOwner(firmId);
    }
    
    // ==========================================
    // Documents Collection
    // ==========================================
    match /tap/{namespace}/documents/{documentId} {
      // Allow authenticated users to read documents
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create documents
      allow create: if isValidDocument() && isAuthenticated();
      
      // Allow authenticated users to update their own documents
      allow update: if isAuthenticated() && isOwner(documentId);
      
      // Allow authenticated users to delete their own documents
      allow delete: if isAuthenticated() && isOwner(documentId);
      
      // ==========================================
      // Document Versions Subcollection
      // ==========================================
      match /versions/{versionId} {
        // Allow authenticated users to read versions
        allow read: if isAuthenticated();
        
        // Allow authenticated users to create versions
        allow create: if isAuthenticated();
        
        // Allow authenticated users to delete versions
        allow delete: if isAuthenticated() && isOwner(versionId);
      }
    }
    
    // ==========================================
    // Department Profiles Collection
    // ==========================================
    match /tap/{namespace}/departmentProfiles/{profileId} {
      // Allow authenticated users to read department profiles
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create department profiles
      allow create: if isValidDepartmentProfile() && isAuthenticated();
      
      // Allow authenticated users to update their own profiles
      allow update: if isAuthenticated() && isOwner(profileId);
      
      // Allow authenticated users to delete their own profiles
      allow delete: if isAuthenticated() && isOwner(profileId);
    }
    
    // ==========================================
    // Settings Document (Singleton)
    // ==========================================
    match /tap/{namespace}/settings/{settingId} {
      // Allow authenticated users to read settings
      allow read: if isAuthenticated();
      
      // Allow authenticated users to update settings (only specific fields)
      allow update: if isAuthenticated() && 
                           isValidSettings() &&
                           request.resource.data.id == resource.data.id;
    }
    
    // ==========================================
    // Tender Items (Embedded in Tenders)
    // Note: These are not separate documents, but embedded arrays
    // ==========================================
    
    // ==========================================
    // Document Versions (Embedded in Documents)
    // Note: These are stored in subcollections
    // ==========================================
  }
}
