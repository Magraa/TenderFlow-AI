// Firestore Security Rules for Top-Level Root Collections
// Version: 2.0.0
// Project: auto-tender-pro

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read & write access to all root collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
